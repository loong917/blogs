---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const blogs = await getCollection('blogs');
const tagCounts = [...new Set(blogs.flatMap((blog) => blog.data.tags))]
  .map((tag) => ({ tag, count: blogs.filter((blog) => blog.data.tags.includes(tag)).length }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

const maxCount = Math.max(...tagCounts.map((t) => t.count), 1);
const minCount = Math.min(...tagCounts.map((t) => t.count), maxCount);
const tags = tagCounts.map((entry) => ({
  ...entry,
  weight: maxCount === minCount ? 1 : (entry.count - minCount) / (maxCount - minCount),
}));
---

<Layout title="所有标签 · loong博客" canonicalPath="/tags">
  <main id="main-content">
    <Header title="loong博客" active="tags" />
    <div class="content-width tags-page">
      <h1 class="page-title">所有标签</h1>
      <p class="page-intro">从主题进入内容，找到长期积累的知识脉络。</p>

      <div class="tag-cloud">
        {
          tags.map(({ tag, count, weight }, index) => (
            <a href={`/tags/${tag}`} style={`--tag-order: ${index}; --tag-weight: ${weight.toFixed(2)};`} data-reveal>
              <span>{tag}</span>
              <small>{String(count)} 篇</small>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .tags-page {
    padding-top: var(--collection-offset);
  }

  .tag-cloud {
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 2.8rem;
  }

  .tag-cloud a {
    align-items: center;
    background: var(--surface-soft);
    border: 1px solid var(--surface-card-border);
    border-radius: 1.2rem;
    display: grid;
    gap: 0.35rem;
    grid-template-columns: 1fr auto;
    padding: 1.2rem;
    position: relative;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease, border-color 160ms ease;
  }

  .tag-cloud a:hover {
    background: var(--surface-strong);
    border-color: rgba(202, 112, 72, 0.25);
    transform: translateY(-2px);
  }

  .tag-cloud a::after {
    background: var(--clay);
    border-radius: 99px;
    bottom: 0;
    content: '';
    height: 2px;
    left: 1.2rem;
    opacity: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 180ms ease, transform 180ms ease;
    width: 2.5rem;
  }

  .tag-cloud a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .tag-cloud a[data-reveal] {
    transition-delay: calc(var(--tag-order, 0) * 35ms);
  }

  .tag-cloud span {
    font-family: var(--font-serif);
    font-size: calc(1.05rem + 0.5rem * var(--tag-weight, 0));
  }

  .tag-cloud small {
    color: var(--ink-muted);
    font-size: 0.62rem;
    grid-column: 1;
  }

  .tag-cloud i {
    color: var(--clay);
    font-style: normal;
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  @media (max-width: 580px) {
    .tag-cloud {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 24rem) {
    .tag-cloud {
      margin-top: 2rem;
    }

    .tag-cloud a {
      border-radius: 1rem;
      padding: 1rem;
    }
  }
</style>
