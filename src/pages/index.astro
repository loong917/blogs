---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EntryList from "../components/EntryList.astro";

const blogs = await getCollection("blogs");
const sortedBlogs = blogs.sort((a, b) => b.data.id - a.data.id).slice(0, 9);
---

<Layout title="loong博客" canonicalPath="/">
  <main id="main-content">
    <Header title="loong博客" active="latest" />
    <div class="content-width">
      <section class="collection-hero" aria-labelledby="home-title">
        <h1 id="home-title" class="page-title">最新文章</h1>
        <p class="page-intro">记录一路所见，记录一切美好。</p>
      </section>

      <nav class="filter-row" aria-label="文章筛选">
        <a class="filter-pill active" href="/" aria-current="page">最新记录</a>
        <a class="filter-pill" href="/tags/programming">programming</a>
        <a class="filter-pill" href="/tags/wikipedia">wikipedia</a>
        <a class="filter-pill" href="/blogs">全部文章</a>
      </nav>

      <EntryList entries={sortedBlogs} />

      <a class="more-link" href="/blogs">
        <span>浏览全部文章</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .more-link {
    align-items: center;
    border-top: 1px solid var(--line);
    color: var(--clay-dark);
    display: flex;
    font-size: 0.78rem;
    font-weight: 700;
    justify-content: space-between;
    margin: 2.5rem 0 0 4.6rem;
    padding: 1.4rem 0;
    text-decoration: none;
  }

  @media (max-width: 40rem) {
    .more-link {
      margin-left: 3.45rem;
    }
  }

  @media (max-width: 24rem) {
    .more-link {
      margin-left: 2.85rem;
    }
  }
</style>
