---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EntryList from '../components/EntryList.astro';

const blogs = await getCollection('blogs');
const sortedBlogs = blogs.sort((a, b) => b.data.id - a.data.id).slice(0, 9);
---

<Layout title="loong博客" canonicalPath="/">
  <main id="main-content">
    <Header title="loong博客" active="latest" />
    <div class="content-width">

      <nav class="filter-row" aria-label="文章筛选">
        <a class="filter-pill active" href="/">最新记录</a>
        <a class="filter-pill" href="/tags/programming">programming</a>
        <a class="filter-pill" href="/tags/wikipedia">wikipedia</a>
        <a class="filter-pill" href="/blogs">全部文章</a>
      </nav>

      <EntryList entries={sortedBlogs} />

      <a class="more-link" href="/blogs">
        <span>浏览全部文章</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <Footer />
  </main>
</Layout>

<style>

  .collection-meta {
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    margin: 0 0 0.8rem;
  }

  .collection-meta span {
    color: var(--clay);
    margin: 0 0.28rem;
  }

  .more-link {
    align-items: center;
    border-top: 1px solid var(--line);
    color: var(--clay-dark);
    display: flex;
    font-size: 0.78rem;
    font-weight: 700;
    justify-content: space-between;
    margin: 2.5rem 0 0 4.6rem;
    padding: 1.4rem 0;
    text-decoration: none;
  }

  @media (max-width: 540px) {
    .more-link {
      margin-left: 3.45rem;
    }
  }
</style>
