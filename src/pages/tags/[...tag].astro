---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EntryList from '../../components/EntryList.astro';

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  const uniqueTags = [...new Set(blogs.flatMap((blog) => blog.data.tags))];
  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      blogs: blogs
        .filter((blog) => blog.data.tags.includes(tag))
        .sort((a, b) => b.data.id - a.data.id),
    },
  }));
}

const { blogs } = Astro.props;
const tag = Astro.params.tag ?? '';
---

<Layout title={`#${tag} · loong博客`} canonicalPath={`/tags/${encodeURIComponent(tag)}`}>
  <main id="main-content">
    <Header title="loong博客" active="tags" />
    <div class="content-width tag-page">
      <section class="collection-hero" aria-labelledby="tag-title">
        <h1 class="page-title" id="tag-title">#{tag}</h1>
        <p class="page-intro">收集在“{tag}”标签下的全部博客。</p>
        <a class="back" href="/tags">← 返回所有标签</a>
      </section>
      <div class="entries">
        <EntryList entries={blogs} />
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .back {
    color: var(--ink-muted);
    display: inline-block;
    font-size: 0.7rem;
    margin-top: 1rem;
    text-decoration: none;
  }

  .entries {
    margin-top: 2.8rem;
  }
</style>
