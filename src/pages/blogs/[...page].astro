---
import { getCollection } from 'astro:content';
import type { PaginateFunction } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Pagination from '../../components/Pagination.astro';
import Footer from '../../components/Footer.astro';
import EntryList from '../../components/EntryList.astro';

export const PAGE_SIZE = 10;

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const blogs = await getCollection('blogs');
  return paginate(blogs.sort((a, b) => b.data.id - a.data.id), { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
---

<Layout title={`文章归档 · 第 ${page.currentPage} 页`} canonicalPath={page.currentPage === 1 ? '/blogs' : `/blogs/${page.currentPage}`}>
  <main id="main-content">
    <Header title="loong博客" active="articles" />
    <div class="content-width archive">
      <h1 class="page-title">所有文章</h1>
      <nav class="filter-row" aria-label="归档导航">
        <a class="filter-pill active" href="/blogs">全部</a>
        <a class="filter-pill" href="/tags">按标签查看</a>
        <span class="entry-total">共 {page.total} 篇</span>
      </nav>
      <EntryList entries={page.data} />
      <Pagination page={page} />
    </div>
    <Footer />
  </main>
</Layout>

<style>
  .archive {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .entry-total {
    align-self: center;
    color: var(--ink-muted);
    font-size: 0.72rem;
    margin-left: auto;
  }

  @media (max-width: 30rem) {
    .entry-total {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
