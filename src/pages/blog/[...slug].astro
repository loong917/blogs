---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { createExcerpt, getDateView, getReadingMinutes } from '../../utils/blog';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blogs');
  return blogEntries.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry('blogs', slug);

if (!entry || !('render' in entry)) return Astro.redirect('/404');

const { Content } = await entry.render();
const { id, title, image, tags, date, summary } = entry.data;
const excerpt = createExcerpt(entry.body, summary, 150);
const dateView = getDateView(date, id);
const readingMinutes = getReadingMinutes(entry.body);
---

<Layout title={`${title} · loong博客`} description={excerpt} canonicalPath={`/blog/${id}`}>
  <main id="main-content">
    <div class="reading-progress" aria-hidden="true">
      <span id="reading-progress-bar"></span>
    </div>
    <Header title="loong博客" active="articles" />
    <nav class="toc" id="toc" aria-label="文章目录" hidden>
      <div class="toc-heading">
        <strong>本文目录</strong>
      </div>
      <ul id="toc-list" data-toc-list></ul>
    </nav>
    <div class="reading-width">
      <a class="back-link" href="/blogs">← 返回文章集合</a>

      <header class="entry-hero">
        <p class="page-kicker">{dateView.weekday} · {date} · 约 {readingMinutes} 分钟阅读</p>
        <div class="article-mark" style={`--bgURL: url('/${image}');`} aria-hidden="true" transition:name={`article-mark-${id}`}>
          <span></span>
        </div>
        <h1 transition:name={`article-title-${id}`}>{title}</h1>
        <div class="tag-row">
          {tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
        </div>
      </header>

      <nav class="toc-mobile" id="toc-mobile" aria-label="本文目录" hidden>
        <div class="toc-mobile-heading">
          <strong>目录</strong>
          <small id="toc-mobile-count"></small>
        </div>
        <ol id="toc-list-mobile" data-toc-list></ol>
      </nav>

      <article class="journal-prose">
        <Content />
      </article>

      <div class="end-mark" aria-label="文章结束">
        <span></span>
        <i></i>
        <span></span>
      </div>
      <a class="back-to-collection" href="/blogs">继续阅读其他文章 <span>→</span></a>
    </div>
    <Footer />
  </main>
</Layout>

<style is:global>
  .reading-progress {
    height: 3px;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 60;
  }

  .reading-progress span {
    background: linear-gradient(90deg, var(--clay), var(--clay-dark));
    display: block;
    height: 100%;
    transition: width 80ms linear;
    width: 0%;
  }

  .toc {
    display: none;
  }

  @media (min-width: 80rem) {
    .toc:not([hidden]) {
      border-left: 1px solid var(--line);
      display: block;
      left: calc(50% + (var(--content-width) / 2) + 2rem);
      max-height: calc(100vh - 11rem);
      overflow-y: auto;
      padding: 0.15rem 0 0.15rem 1rem;
      position: fixed;
      top: 7rem;
      width: min(15rem, calc(50vw - (var(--content-width) / 2) - 3rem));
    }
  }

  .toc-heading {
    margin-bottom: 0.75rem;
  }

  .toc-heading strong {
    color: var(--ink);
    display: block;
    font-family: var(--font-serif);
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  .toc ul {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item a {
    border-left: 2px solid transparent;
    border-radius: 0 0.55rem 0.55rem 0;
    color: var(--ink-muted);
    display: block;
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.38rem 0.55rem 0.38rem 0.7rem;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }

  .toc-item.toc-sub a {
    font-size: 0.72rem;
    padding-left: 1.25rem;
  }

  .toc-item a:hover,
  .toc-item a.is-active {
    border-left-color: var(--clay);
    color: var(--clay-dark);
  }

  .toc-item a.is-active {
    font-weight: 700;
  }

  .toc-mobile {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .toc-mobile-heading {
    align-items: baseline;
    display: flex;
    min-height: 1.5rem;
  }

  .toc-mobile-heading strong {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 0.96rem;
  }

  .toc-mobile-heading small {
    color: var(--ink-muted);
    font-size: 0.7rem;
    margin-left: auto;
  }

  .toc-mobile ol {
    counter-reset: toc-item;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-mobile .toc-item {
    counter-increment: toc-item;
    min-width: 0;
  }

  .toc-mobile .toc-item a,
  .toc-mobile .toc-item.toc-sub a {
    align-items: center;
    background: var(--surface-soft);
    border: 1px solid var(--surface-card-border);
    border-radius: 0.7rem;
    color: var(--ink-soft);
    display: grid;
    font-size: 0.76rem;
    gap: 0.5rem;
    grid-template-columns: auto minmax(0, 1fr);
    line-height: 1.45;
    min-height: 3.25rem;
    padding: 0.7rem;
    transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
    white-space: normal;
  }

  .toc-mobile .toc-item a::before {
    align-items: center;
    color: var(--ink-muted);
    content: counter(toc-item, decimal-leading-zero);
    display: flex;
    font-size: 0.6rem;
    font-variant-numeric: tabular-nums;
    height: 1.45rem;
    justify-content: center;
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  .toc-mobile .toc-item-label {
    display: block;
    line-height: 1.45;
  }

  .toc-mobile .toc-item.toc-sub a {
    font-size: 0.72rem;
  }

  .toc-mobile .toc-item a:hover,
  .toc-mobile .toc-item a.is-active {
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--clay) 52%, var(--surface-card-border));
    color: var(--clay-dark);
  }

  .toc-mobile .toc-item a:hover {
    transform: translateY(-1px);
  }

  .toc-mobile .toc-item a.is-active {
    box-shadow: 0 0.45rem 1.1rem rgba(153, 80, 56, 0.1);
  }

  .toc-mobile .toc-item a.is-active::before {
    color: var(--clay);
    font-weight: 800;
  }

  @media (max-width: 25rem) {
    .toc-mobile ol {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 80rem) {
    .toc-mobile {
      display: none;
    }
  }

  .reading-width {
    margin: 0 auto;
    max-width: var(--content-width);
    width: 100%;
  }

  .back-link {
    align-items: center;
    color: var(--ink-muted);
    display: inline-flex;
    font-size: 0.7rem;
    margin-top: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .entry-hero {
    border-bottom: 1px solid var(--line);
    margin: 0;
    padding: clamp(2.5rem, 7vw, 4.75rem) 0 clamp(2.25rem, 5vw, 3.5rem);
    text-align: center;
  }

  .article-mark {
    align-items: center;
    background: var(--surface-card);
    border: 1px solid var(--surface-card-border);
    border-radius: 1.35rem;
    box-shadow: 0 12px 30px rgba(76, 59, 48, 0.06);
    display: flex;
    height: 4.6rem;
    justify-content: center;
    margin: 1.5rem auto 1.8rem;
    transform: rotate(-2deg);
    width: 4.6rem;
  }

  .article-mark span {
    background: center / contain no-repeat var(--bgURL);
    filter: sepia(0.45) saturate(0.55);
    height: 2rem;
    opacity: 0.72;
    transform: rotate(2deg);
    width: 2rem;
  }

  .entry-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 7vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.1;
    margin: 0 auto;
    max-width: 720px;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  @media (prefers-reduced-motion: no-preference) {
    .entry-hero .page-kicker,
    .entry-hero .article-mark,
    .entry-hero h1,
    .entry-hero .tag-row {
      animation: journal-hero-reveal 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .entry-hero .article-mark {
      animation-delay: 70ms;
      animation-name: journal-mark-reveal;
    }

    .entry-hero h1 {
      animation-delay: 130ms;
    }

    .entry-hero .tag-row {
      animation-delay: 190ms;
    }

    @keyframes journal-hero-reveal {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes journal-mark-reveal {
      from {
        opacity: 0;
        transform: translateY(10px) rotate(-2deg);
      }

      to {
        opacity: 1;
        transform: rotate(-2deg);
      }
    }
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    justify-content: center;
    margin-top: 1.4rem;
  }

  .tag-row a {
    align-items: center;
    color: var(--clay-dark);
    display: inline-flex;
    font-size: 0.7rem;
    min-height: 2.25rem;
    text-decoration: none;
  }

  .journal-prose {
    border-top: 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.95;
    min-width: 0;
    overflow-wrap: break-word;
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  .journal-prose > :first-child {
    margin-top: 0;
  }

  .journal-prose h1,
  .journal-prose h2,
  .journal-prose h3,
  .journal-prose h4,
  .journal-prose h5,
  .journal-prose h6 {
    color: var(--ink);
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.35;
    scroll-margin-top: 6rem;
    text-wrap: balance;
  }

  .journal-prose h2 {
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    margin: 3.5rem 0 1.15rem;
    padding-bottom: 0.65rem;
  }

  .journal-prose h3 {
    font-size: 1.4rem;
    margin: 3rem 0 1rem;
  }

  .journal-prose h4,
  .journal-prose h5,
  .journal-prose h6 {
    font-size: 1.1rem;
    margin: 2.4rem 0 0.8rem;
  }

  .journal-prose p {
    margin: 1.1rem 0;
    text-align: justify;
  }

  .journal-prose a {
    color: var(--clay-dark);
    text-decoration-color: rgba(153, 80, 56, 0.35);
    text-underline-offset: 0.2em;
    transition: color var(--motion-fast) var(--ease-standard), text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .journal-prose a:hover {
    color: var(--clay);
    text-decoration-color: currentColor;
  }

  .journal-prose strong {
    color: var(--ink);
  }

  .journal-prose .journal-list {
    --journal-list-line-height: 1.95em;
    margin: 1.35rem 0;
    padding-left: 0;
  }

  .journal-prose .journal-list-item {
    align-items: start;
    column-gap: 0.7rem;
    display: grid;
    grid-template-columns: 1.45rem minmax(0, 1fr);
    margin: 0.55rem 0;
    min-width: 0;
  }

  .journal-prose .journal-list-unordered,
  .journal-prose .journal-list-ordered {
    list-style: none;
  }

  .journal-prose .journal-list-marker {
    grid-column: 1;
    grid-row: 1;
    justify-self: center;
  }

  .journal-prose .journal-list-unordered .journal-list-marker {
    background: var(--clay);
    border: 3px solid var(--surface-card);
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(202, 112, 72, 0.24);
    height: 0.62rem;
    margin-top: calc((var(--journal-list-line-height) - 0.62rem) / 2);
    width: 0.62rem;
  }

  .journal-prose .journal-list-ordered {
    counter-reset: journal-list;
  }

  .journal-prose .journal-list-ordered .journal-list-item {
    counter-increment: journal-list;
  }

  .journal-prose .journal-list-ordered .journal-list-marker {
    align-items: center;
    background: rgba(202, 112, 72, 0.11);
    border: 1px solid rgba(202, 112, 72, 0.18);
    border-radius: 999px;
    color: var(--clay-dark);
    display: flex;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    height: 1.45rem;
    justify-content: center;
    margin-top: calc((var(--journal-list-line-height) - 1.45rem) / 2);
    width: 1.45rem;
  }

  .journal-prose .journal-list-ordered .journal-list-marker::before {
    content: counter(journal-list);
  }

  .journal-prose .journal-list-content {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .journal-prose .journal-list-content > p {
    line-height: inherit;
    margin: 0;
    text-align: left;
  }

  .journal-prose .journal-list-content > p + p {
    margin-top: 0.55rem;
  }

  .journal-prose .journal-list-content > .journal-list {
    border-left: 1px solid var(--line);
    margin: 0.7rem 0 0.8rem 0.2rem;
    padding-left: 1rem;
  }

  .journal-prose .contains-task-list {
    list-style: none;
  }

  .journal-prose .task-list-item {
    padding-left: 1.75rem;
  }

  .journal-prose .task-list-item::before {
    display: none;
  }

  .journal-prose .task-list-item input[type='checkbox'] {
    accent-color: var(--clay);
    height: 0.95rem;
    left: 0;
    margin: 0;
    position: absolute;
    top: 0.48rem;
    width: 0.95rem;
  }

  .journal-prose hr {
    border: 0;
    height: 3rem;
    margin: 2.5rem 0;
    position: relative;
  }

  .journal-prose hr::before {
    color: var(--clay);
    content: '·  ·  ·';
    font-family: var(--font-serif);
    left: 50%;
    letter-spacing: 0.35em;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .journal-prose mark {
    background: rgba(216, 173, 105, 0.28);
    border-radius: 0.2em;
    color: var(--ink);
    padding: 0.05em 0.18em;
  }

  .journal-prose kbd {
    background: var(--surface-strong);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 0.35rem;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.72em;
    padding: 0.15em 0.4em;
  }

  .journal-prose .journal-reference-heading {
    border-bottom: 0;
    font-size: 1.35rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0;
  }

  .journal-prose .journal-references {
    counter-reset: reference-item;
    display: grid;
    gap: 0.7rem;
    margin: 0 0 2.5rem;
  }

  .journal-prose .journal-references > li {
    background: var(--surface-subtle);
    border: 1px solid var(--surface-card-border);
    border-radius: 0.9rem;
    counter-increment: reference-item;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.65;
    margin: 0;
    min-height: 3.2rem;
    padding: 0.85rem 2.8rem 0.85rem 3.4rem;
    transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
  }

  .journal-prose .journal-references > li:hover {
    background: var(--surface-strong);
    border-color: rgba(202, 112, 72, 0.2);
    transform: translateX(2px);
  }

  .journal-prose .journal-references > li::before {
    align-items: center;
    background: rgba(202, 112, 72, 0.11);
    border: 1px solid rgba(202, 112, 72, 0.2);
    border-radius: 0.55rem;
    box-shadow: none;
    color: var(--clay-dark);
    content: counter(reference-item, decimal-leading-zero);
    display: flex;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 800;
    height: 1.75rem;
    justify-content: center;
    left: 0.9rem;
    letter-spacing: 0.04em;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.75rem;
  }

  .journal-prose .journal-references > li::after {
    color: var(--clay);
    content: '↗';
    font-family: var(--font-sans);
    font-size: 0.8rem;
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .journal-prose .journal-references a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .journal-prose .journal-references a:hover {
    color: var(--clay-dark);
  }

  .journal-prose .journal-callout {
    background: var(--surface-subtle);
    border: 0;
    border-left: 3px solid var(--clay);
    border-radius: 0 1.2rem 1.2rem 0;
    color: var(--ink-soft);
    margin: 2rem 0;
    padding: 1.1rem 1.35rem;
  }

  .journal-prose .journal-callout > :first-child {
    margin-top: 0;
  }

  .journal-prose .journal-callout > :last-child {
    margin-bottom: 0;
  }

  .journal-prose .journal-code {
    background: #27231f !important;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1.2rem;
    box-shadow: 0 18px 38px rgba(58, 43, 31, 0.12);
    color: #eee5d8;
    margin: 1.8rem 0;
    overflow: auto;
    overscroll-behavior-inline: contain;
    padding: 2.4rem 1.25rem 1.25rem;
    position: relative;
    width: 100%;
  }

  .journal-prose .journal-code::before {
    color: #ad9f91;
    content: attr(data-language);
    font-family: var(--font-sans);
    font-size: 0.58rem;
    left: 1.3rem;
    letter-spacing: 0.12em;
    position: absolute;
    text-transform: uppercase;
    top: 0.8rem;
  }

  .journal-prose .journal-code::after {
    background: #cc7350;
    border-radius: 50%;
    box-shadow: 0.75rem 0 #d8ad69, 1.5rem 0 #849c7a;
    content: '';
    height: 0.42rem;
    position: absolute;
    right: 2.8rem;
    top: 0.92rem;
    width: 0.42rem;
  }

  .journal-prose pre code {
    background: transparent;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    font-size: 0.78rem;
    line-height: 1.75;
    padding: 0;
  }

  .journal-prose :not(pre) > code {
    background: rgba(169, 145, 116, 0.15);
    border-radius: 0.35rem;
    color: var(--clay-dark);
    font-family: Consolas, monospace;
    font-size: 0.84em;
    padding: 0.18em 0.4em;
  }

  .journal-figure {
    margin: 2.6rem 0;
    width: 100%;
  }

  .journal-image {
    border-radius: 1.25rem;
    box-shadow: 0 16px 42px rgba(61, 48, 37, 0.12);
    display: block;
    height: auto;
    object-fit: contain;
    width: 100%;
  }

  .journal-figure figcaption {
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    margin-top: 0.75rem;
    text-align: center;
  }

  .journal-table-wrap {
    margin: 2rem 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .journal-prose table {
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    min-width: 100%;
  }

  .journal-prose th,
  .journal-prose td {
    border-bottom: 1px solid var(--line);
    padding: 0.8rem;
    text-align: left;
  }

  .journal-prose th {
    color: var(--ink);
    font-weight: 700;
  }

  .end-mark {
    align-items: center;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    margin: 4rem 0 2rem;
  }

  .end-mark span {
    background: var(--line);
    height: 1px;
    width: 3rem;
  }

  .end-mark i {
    background: var(--clay);
    border-radius: 50%;
    height: 0.45rem;
    width: 0.45rem;
  }

  .back-to-collection {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    color: var(--ink-soft);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    text-decoration: none;
  }

  .back-to-collection span {
    color: var(--clay-dark);
  }

  html {
    --astro-code-color-text: #e9e1d5;
    --astro-code-color-background: #27231f;
    --astro-code-token-constant: #d9af7a;
    --astro-code-token-string: #a8bd91;
    --astro-code-token-comment: #857b72;
    --astro-code-token-keyword: #d28c78;
    --astro-code-token-parameter: #c9b9d8;
    --astro-code-token-function: #d8c28f;
    --astro-code-token-string-expression: #a8bd91;
    --astro-code-token-punctuation: #bdb2a7;
    --astro-code-token-link: #9cb8c4;
  }

  @media (max-width: 48rem) {
    .entry-hero {
      padding-block: 2.5rem 2.25rem;
