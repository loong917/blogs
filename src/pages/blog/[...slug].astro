---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { createExcerpt, getDateView } from '../../utils/blog';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blogs');
  return blogEntries.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry('blogs', slug);

if (!entry || !('render' in entry)) return Astro.redirect('/404');

const { Content } = await entry.render();
const { id, title, image, tags, date, summary } = entry.data;
const excerpt = createExcerpt(entry.body, summary, 150);
const dateView = getDateView(date, id);
---

<Layout title={`${title} · loong博客`} description={excerpt} canonicalPath={`/blog/${id}`}>
  <main id="main-content">
    <Header title="loong博客" active="articles" />
    <div class="reading-width">
      <a class="back-link" href="/blogs">← 返回文章集合</a>

      <header class="entry-hero">
        <p class="page-kicker">{dateView.weekday} · {date}</p>
        <div class="article-mark" style={`--bgURL: url('/${image}');`} aria-hidden="true" transition:name={`article-mark-${id}`}>
          <span></span>
        </div>
        <h1 transition:name={`article-title-${id}`}>{title}</h1>
        <div class="tag-row">
          {tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
        </div>
      </header>

      <article class="journal-prose">
        <Content />
      </article>

      <div class="end-mark" aria-label="文章结束">
        <span></span>
        <i></i>
        <span></span>
      </div>
      <a class="back-to-collection" href="/blogs">继续阅读其他文章 <span>→</span></a>
    </div>
    <Footer />
  </main>
</Layout>

<style is:global>
  .reading-width {
    margin: 0 auto;
    max-width: var(--content-width);
    width: 100%;
  }

  .back-link {
    color: var(--ink-muted);
    display: inline-block;
    font-size: 0.7rem;
    margin-top: 0.75rem;
    text-decoration: none;
  }

  .entry-hero {
    padding: clamp(2.5rem, 7vw, 4.75rem) 0 clamp(2.25rem, 5vw, 3.5rem);
    text-align: center;
  }

  .article-mark {
    align-items: center;
    background: rgba(255, 255, 255, 0.36);
    border: 1px solid rgba(91, 73, 56, 0.08);
    border-radius: 1.35rem;
    box-shadow: 0 12px 30px rgba(76, 59, 48, 0.06);
    display: flex;
    height: 4.6rem;
    justify-content: center;
    margin: 1.5rem auto 1.8rem;
    transform: rotate(-2deg);
    width: 4.6rem;
  }

  .article-mark span {
    background: center / contain no-repeat var(--bgURL);
    filter: sepia(0.45) saturate(0.55);
    height: 2rem;
    opacity: 0.72;
    transform: rotate(2deg);
    width: 2rem;
  }

  .entry-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 7vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.1;
    margin: 0 auto;
    max-width: 720px;
    text-wrap: balance;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    justify-content: center;
    margin-top: 1.4rem;
  }

  .tag-row a {
    color: var(--clay-dark);
    font-size: 0.7rem;
    text-decoration: none;
  }

  .journal-prose {
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.95;
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  .journal-prose > :first-child {
    margin-top: 0;
  }

  .journal-prose h1,
  .journal-prose h2,
  .journal-prose h3,
  .journal-prose h4,
  .journal-prose h5,
  .journal-prose h6 {
    color: var(--ink);
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.35;
    scroll-margin-top: 2rem;
    text-wrap: balance;
  }

  .journal-prose h2 {
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    margin: 3.5rem 0 1.15rem;
    padding-bottom: 0.65rem;
  }

  .journal-prose h3 {
    font-size: 1.4rem;
    margin: 3rem 0 1rem;
  }

  .journal-prose h4,
  .journal-prose h5,
  .journal-prose h6 {
    font-size: 1.1rem;
    margin: 2.4rem 0 0.8rem;
  }

  .journal-prose p {
    margin: 1.1rem 0;
    text-align: justify;
  }

  .journal-prose a {
    color: var(--clay-dark);
    text-decoration-color: rgba(153, 80, 56, 0.35);
    text-underline-offset: 0.2em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .journal-prose a:hover {
    color: var(--clay);
    text-decoration-color: currentColor;
  }

  .journal-prose strong {
    color: var(--ink);
  }

  .journal-prose ul,
  .journal-prose ol {
    margin: 1.35rem 0;
    padding-left: 0;
  }

  .journal-prose li {
    margin: 0.55rem 0;
    position: relative;
  }

  .journal-prose ul {
    list-style: none;
  }

  .journal-prose ul > li {
    padding-left: 1.45rem;
  }

  .journal-prose ul > li::before {
    background: var(--clay);
    border: 3px solid color-mix(in srgb, var(--paper) 72%, white);
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(202, 112, 72, 0.24);
    content: '';
    height: 0.62rem;
    left: 0.08rem;
    position: absolute;
    top: 0.72em;
    transform: translateY(-50%);
    width: 0.62rem;
  }

  .journal-prose ol {
    counter-reset: journal-list;
    list-style: none;
  }

  .journal-prose ol > li {
    counter-increment: journal-list;
    padding-left: 2.25rem;
  }

  .journal-prose ol > li::before {
    align-items: center;
    background: rgba(202, 112, 72, 0.11);
    border: 1px solid rgba(202, 112, 72, 0.18);
    border-radius: 999px;
    color: var(--clay-dark);
    content: counter(journal-list);
    display: flex;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    height: 1.45rem;
    justify-content: center;
    left: 0;
    position: absolute;
    top: 0.26rem;
    width: 1.45rem;
  }

  .journal-prose li > p {
    margin: 0.35rem 0;
    text-align: left;
  }

  .journal-prose li > ul,
  .journal-prose li > ol {
    border-left: 1px solid var(--line);
    margin: 0.7rem 0 0.8rem 0.2rem;
    padding-left: 1rem;
  }

  .journal-prose .contains-task-list {
    list-style: none;
  }

  .journal-prose .task-list-item {
    padding-left: 1.75rem;
  }

  .journal-prose .task-list-item::before {
    display: none;
  }

  .journal-prose .task-list-item input[type='checkbox'] {
    accent-color: var(--clay);
    height: 0.95rem;
    left: 0;
    margin: 0;
    position: absolute;
    top: 0.48rem;
    width: 0.95rem;
  }

  .journal-prose hr {
    border: 0;
    height: 3rem;
    margin: 2.5rem 0;
    position: relative;
  }

  .journal-prose hr::before {
    color: var(--clay);
    content: '·  ·  ·';
    font-family: var(--font-serif);
    left: 50%;
    letter-spacing: 0.35em;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .journal-prose mark {
    background: rgba(216, 173, 105, 0.28);
    border-radius: 0.2em;
    color: var(--ink);
    padding: 0.05em 0.18em;
  }

  .journal-prose kbd {
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 0.35rem;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.72em;
    padding: 0.15em 0.4em;
  }

  .journal-prose .journal-reference-heading {
    border-bottom: 0;
    font-size: 1.35rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0;
  }

  .journal-prose .journal-references {
    counter-reset: reference-item;
    display: grid;
    gap: 0.7rem;
    margin: 0 0 2.5rem;
  }

  .journal-prose .journal-references > li {
    background: rgba(255, 255, 255, 0.32);
    border: 1px solid rgba(87, 69, 52, 0.07);
    border-radius: 0.9rem;
    counter-increment: reference-item;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.65;
    margin: 0;
    min-height: 3.2rem;
    padding: 0.85rem 2.8rem 0.85rem 3.4rem;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .journal-prose .journal-references > li:hover {
    background: rgba(255, 255, 255, 0.52);
    border-color: rgba(202, 112, 72, 0.2);
    transform: translateX(2px);
  }

  .journal-prose .journal-references > li::before {
    align-items: center;
    background: rgba(202, 112, 72, 0.11);
    border: 1px solid rgba(202, 112, 72, 0.2);
    border-radius: 0.55rem;
    box-shadow: none;
    color: var(--clay-dark);
    content: counter(reference-item, decimal-leading-zero);
    display: flex;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 800;
    height: 1.75rem;
    justify-content: center;
    left: 0.9rem;
    letter-spacing: 0.04em;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.75rem;
  }

  .journal-prose .journal-references > li::after {
    color: var(--clay);
    content: '↗';
    font-family: var(--font-sans);
    font-size: 0.8rem;
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .journal-prose .journal-references a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .journal-prose .journal-references a:hover {
    color: var(--clay-dark);
  }

  .journal-prose .journal-callout {
    background: rgba(255, 255, 255, 0.32);
    border: 0;
    border-left: 3px solid var(--clay);
    border-radius: 0 1.2rem 1.2rem 0;
    color: var(--ink-soft);
    margin: 2rem 0;
    padding: 1.1rem 1.35rem;
  }

  .journal-prose .journal-callout > :first-child {
    margin-top: 0;
  }

  .journal-prose .journal-callout > :last-child {
    margin-bottom: 0;
  }

  .journal-prose .journal-code {
    background: #27231f !important;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1.2rem;
    box-shadow: 0 18px 38px rgba(58, 43, 31, 0.12);
    color: #eee5d8;
    margin: 1.8rem 0;
    overflow: auto;
    padding: 2.4rem 1.25rem 1.25rem;
    position: relative;
  }

  .journal-prose .journal-code::before {
    color: #ad9f91;
    content: attr(data-language);
    font-family: var(--font-sans);
    font-size: 0.58rem;
    left: 1.3rem;
    letter-spacing: 0.12em;
    position: absolute;
    text-transform: uppercase;
    top: 0.8rem;
  }

  .journal-prose .journal-code::after {
    background: #cc7350;
    border-radius: 50%;
    box-shadow: 0.75rem 0 #d8ad69, 1.5rem 0 #849c7a;
    content: '';
    height: 0.42rem;
    position: absolute;
    right: 2.8rem;
    top: 0.92rem;
    width: 0.42rem;
  }

  .journal-prose pre code {
    background: transparent;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
    font-size: 0.78rem;
    line-height: 1.75;
    padding: 0;
  }

  .journal-prose :not(pre) > code {
    background: rgba(169, 145, 116, 0.15);
    border-radius: 0.35rem;
    color: var(--clay-dark);
    font-family: Consolas, monospace;
    font-size: 0.84em;
    padding: 0.18em 0.4em;
  }

  .journal-figure {
    margin: 2.6rem 0;
  }

  .journal-image {
    border-radius: 1.25rem;
    box-shadow: 0 16px 42px rgba(61, 48, 37, 0.12);
    display: block;
    height: auto;
    max-width: 100%;
  }

  .journal-figure figcaption {
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    margin-top: 0.75rem;
    text-align: center;
  }

  .journal-table-wrap {
    margin: 2rem 0;
    overflow-x: auto;
  }

  .journal-prose table {
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    min-width: 100%;
  }

  .journal-prose th,
  .journal-prose td {
    border-bottom: 1px solid var(--line);
    padding: 0.8rem;
    text-align: left;
  }

  .journal-prose th {
    color: var(--ink);
    font-weight: 700;
  }

  .end-mark {
    align-items: center;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    margin: 4rem 0 2rem;
  }

  .end-mark span {
    background: var(--line);
    height: 1px;
    width: 3rem;
  }

  .end-mark i {
    background: var(--clay);
    border-radius: 50%;
    height: 0.45rem;
    width: 0.45rem;
  }

  .back-to-collection {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    color: var(--ink-soft);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    text-decoration: none;
  }

  .back-to-collection span {
    color: var(--clay-dark);
  }

  html {
    --astro-code-color-text: #e9e1d5;
    --astro-code-color-background: #27231f;
    --astro-code-token-constant: #d9af7a;
    --astro-code-token-string: #a8bd91;
    --astro-code-token-comment: #857b72;
    --astro-code-token-keyword: #d28c78;
    --astro-code-token-parameter: #c9b9d8;
    --astro-code-token-function: #d8c28f;
    --astro-code-token-string-expression: #a8bd91;
    --astro-code-token-punctuation: #bdb2a7;
    --astro-code-token-link: #9cb8c4;
  }

  @media (max-width: 640px) {
    .entry-hero h1 {
      margin-top: 0;
    }

    .journal-prose {
      font-size: 0.98rem;
    }

    .journal-prose h2 {
      font-size: 1.55rem;
      margin-top: 2.8rem;
    }

    .journal-prose h3 {
      font-size: 1.25rem;
      margin-top: 2.35rem;
    }

    .journal-prose .journal-references > li {
      padding: 0.8rem 2.3rem 0.8rem 3rem;
    }

    .journal-prose .journal-references > li::before {
      left: 0.7rem;
    }

    .journal-prose .journal-references > li::after {
      right: 0.75rem;
    }

    .journal-prose .journal-code {
      border-radius: 0.9rem;
      margin-left: -0.5rem;
      margin-right: -0.5rem;
    }
  }
</style>
