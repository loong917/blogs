      margin-block: 1rem 1.4rem;
      width: 4rem;
    }

    .entry-hero h1 {
      font-size: clamp(2rem, 11vw, 2.85rem);
      letter-spacing: -0.035em;
      line-height: 1.14;
    }

    .tag-row {
      gap: 0.35rem 0.65rem;
      margin-top: 1rem;
    }

    .journal-prose {
      font-size: 0.95rem;
      line-height: 1.88;
      padding-top: 2.25rem;
    }

    .journal-prose p {
