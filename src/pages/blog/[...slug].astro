</style>

<script>
  function updateReadingProgress() {
    const article = document.querySelector<HTMLElement>('.journal-prose');
    const bar = document.getElementById('reading-progress-bar');
    if (!article || !bar) return;

    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
    const percent = total > 0 ? (scrolled / total) * 100 : 100;
    bar.style.width = `${percent}%`;
  }

  let tocObserver: IntersectionObserver | null = null;
  let tocClickLockUntil = 0;

  function setActiveToc(id: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-list] a').forEach((link) => {
      const linkId = decodeURIComponent(link.hash.slice(1));
      const isActive = linkId === id;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function createTocItem(heading: HTMLElement) {
    const item = document.createElement('li');
    item.className = `toc-item${heading.tagName === 'H3' ? ' toc-sub' : ''}`;

    const link = document.createElement('a');
    link.href = `#${heading.id}`;
    const label = document.createElement('span');
    label.className = 'toc-item-label';
    label.textContent = (heading.textContent ?? '').trim();
    link.append(label);
    item.append(link);
    return item;
  }

  function buildToc() {
    const desktopNav = document.getElementById('toc');
    const mobileNav = document.getElementById('toc-mobile');
    if (!desktopNav || !mobileNav) return;

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('.journal-prose h2[id], .journal-prose h3[id]'),
    );

    tocObserver?.disconnect();

    if (headings.length < 2) {
      desktopNav.hidden = true;
      mobileNav.hidden = true;
      document.getElementById('toc-list')?.replaceChildren();
      document.getElementById('toc-list-mobile')?.replaceChildren();
      const mobileCount = document.getElementById('toc-mobile-count');
      if (mobileCount) mobileCount.textContent = '';
      return;
    }

    desktopNav.hidden = false;
    mobileNav.hidden = false;
    const desktopList = document.getElementById('toc-list');
    const mobileList = document.getElementById('toc-list-mobile');
    const mobileCount = document.getElementById('toc-mobile-count');
    desktopList?.replaceChildren(...headings.map(createTocItem));
    mobileList?.replaceChildren(...headings.map(createTocItem));
    if (mobileCount) mobileCount.textContent = `${headings.length} 节`;

    document.querySelectorAll<HTMLAnchorElement>('[data-toc-list] a').forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const target = document.getElementById(id);
        if (!target) return;

        event.preventDefault();
        tocClickLockUntil = Date.now() + 1000;
        setActiveToc(id);
        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        window.history.replaceState(null, '', `#${encodeURIComponent(id)}`);

      });
    });

    const currentId = decodeURIComponent(window.location.hash.slice(1));
    const initialHeading = headings.find((heading) => heading.id === currentId) ?? headings[0];
    setActiveToc(initialHeading.id);

    tocObserver = new IntersectionObserver(
      (entries) => {
        if (Date.now() < tocClickLockUntil) return;
        const activeEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((first, second) => first.boundingClientRect.top - second.boundingClientRect.top)[0];
        if (activeEntry) setActiveToc(activeEntry.target.id);
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
    );
    headings.forEach((heading) => tocObserver?.observe(heading));
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.journal-prose')) return;
    updateReadingProgress();
    buildToc();
  });

  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  window.addEventListener('resize', updateReadingProgress);
</script>
