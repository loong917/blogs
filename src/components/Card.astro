---
import { getDateView } from '../utils/blog';

interface Props {
  id: number;
  title: string;
  date: string;
  tags: string[];
  image: string;
  summary?: string;
}

const {
  id,
  title,
  date,
  image,
  tags,
  summary = '打开这篇记录，继续阅读完整内容。',
} = Astro.props;

const dateView = getDateView(date, id);
---

<article class="entry-card">
  <div class="entry-date" aria-label={date}>
    <strong>{dateView.day}</strong>
    <span>{dateView.weekday}</span>
  </div>
  <a
    class="entry-link"
    href={`/blog/${id}`}
  >
    <h3 transition:name={`article-title-${id}`}>{title}</h3>
    <p class="entry-summary">{summary}</p>
    <div class="entry-footer">
      <span class="entry-icon" style={`--bgURL: url('/${image}');`} transition:name={`article-mark-${id}`}></span>
      <span>{tags.slice(0, 3).map((tag) => `#${tag}`).join('　')}</span>
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .entry-card {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 1rem;
  }

  .entry-date {
    color: var(--ink-muted);
    padding-top: 0.7rem;
    text-align: center;
  }

  .entry-date strong,
  .entry-date span {
    display: block;
  }

  .entry-date strong {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1;
  }

  .entry-date span {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }

  .entry-link {
    background: color-mix(in srgb, var(--paper) 82%, white);
    border: 1px solid rgba(78, 67, 53, 0.05);
    border-radius: 1.65rem;
    box-shadow: 0 12px 35px rgba(75, 58, 41, 0.035);
    color: var(--ink);
    display: block;
    padding: 1.25rem 1.35rem 1.15rem;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .entry-link:hover,
  .entry-link:focus-visible {
    border-color: rgba(202, 112, 72, 0.3);
    box-shadow: 0 16px 44px rgba(75, 58, 41, 0.08);
    outline: none;
    transform: translateY(-3px);
  }

  .entry-footer {
    align-items: center;
    display: flex;
  }

  h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    line-height: 1.35;
    margin: 0;
  }

  .entry-summary {
    color: #514940;
    display: -webkit-box;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.7;
    margin: 0.7rem 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .entry-footer {
    color: var(--ink-muted);
    font-size: 0.68rem;
    gap: 0.55rem;
    margin-top: 1.15rem;
  }

  .entry-icon {
    background: center / contain no-repeat var(--bgURL);
    filter: sepia(0.3) saturate(0.65);
    height: 1rem;
    opacity: 0.65;
    width: 1rem;
  }

  .arrow {
    color: var(--clay);
    font-size: 1rem;
    margin-left: auto;
  }

  @media (max-width: 540px) {
    .entry-card {
      grid-template-columns: 2.8rem minmax(0, 1fr);
      gap: 0.65rem;
    }

    .entry-link {
      border-radius: 1.35rem;
      padding: 1.1rem;
    }
  }
</style>
