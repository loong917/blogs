---
import { getDateView } from '../utils/blog';

interface Props {
  id: number;
  title: string;
  date: string;
  tags: string[];
  image: string;
  summary?: string;
  readingMinutes?: number;
}

const {
  id,
  title,
  date,
  image,
  tags,
  summary = '打开这篇记录，继续阅读完整内容。',
  readingMinutes,
} = Astro.props;

const dateView = getDateView(date, id);
---

<article class="entry-card" data-reveal>
  <div class="entry-date" aria-label={date}>
    <strong>{dateView.day}</strong>
    <span>{dateView.weekday}</span>
  </div>
  <a
    class="entry-link"
    href={`/blog/${id}`}
  >
    <h3 transition:name={`article-title-${id}`}>{title}</h3>
    <p class="entry-summary">{summary}</p>
    <div class="entry-footer">
      <span class="entry-icon" style={`--bgURL: url('/${image}');`} transition:name={`article-mark-${id}`}></span>
      <span>{tags.slice(0, 3).map((tag) => `#${tag}`).join('　')}</span>
      {readingMinutes && <span class="entry-reading-time">{readingMinutes} 分钟</span>}
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .entry-card {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 1rem;
  }

  .entry-date {
    color: var(--ink-muted);
    padding-top: 1rem;
    text-align: center;
  }

  .entry-date strong,
  .entry-date span {
    display: block;
  }

  .entry-date strong {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1;
  }

  .entry-date span {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }

  .entry-link {
    background: var(--surface-card);
    border: 1px solid var(--surface-card-border);
    border-radius: 1.65rem;
    box-shadow: var(--shadow-card);
    color: var(--ink);
    display: block;
    min-width: 0;
    overflow: hidden;
    padding: 1.25rem 1.35rem 1.15rem;
    position: relative;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background-color var(--theme-toggle-transition);
  }

  .entry-link:hover,
  .entry-link:focus-visible {
    border-color: rgba(202, 112, 72, 0.3);
    box-shadow: var(--shadow-card-hover);
    outline: none;
    transform: translateY(-3px);
  }

  .entry-link::before {
    background: linear-gradient(180deg, var(--clay), color-mix(in srgb, var(--clay) 20%, transparent));
    border-radius: 99px;
    content: '';
    inset: 1.25rem auto 1.25rem 0;
    opacity: 0;
    position: absolute;
    transform: scaleY(0.35);
    transition: opacity 180ms ease, transform 180ms ease;
    width: 2px;
  }

  .entry-link:hover::before,
  .entry-link:focus-visible::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .entry-footer {
    align-items: center;
    display: flex;
  }

  h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    line-height: 1.35;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .entry-summary {
    color: var(--ink-soft);
    display: -webkit-box;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.7;
    margin: 0.7rem 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .entry-footer {
    color: var(--ink-muted);
    font-size: 0.68rem;
    gap: 0.55rem;
    margin-top: 1.15rem;
    min-width: 0;
  }

  .entry-footer > span:nth-child(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entry-reading-time {
    background: var(--surface-soft);
    border-radius: 999px;
    flex-shrink: 0;
    padding: 0.2rem 0.5rem;
  }

  .entry-icon {
    background: center / contain no-repeat var(--bgURL);
    filter: sepia(0.3) saturate(0.65);
    height: 1rem;
    opacity: 0.65;
    width: 1rem;
  }

  .arrow {
    align-items: center;
    background: var(--accent-soft);
    border-radius: 50%;
    color: var(--clay);
    display: inline-flex;
    font-size: 1rem;
    height: 2rem;
    justify-content: center;
    margin-left: auto;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
    width: 2rem;
  }

  .entry-link:hover .arrow {
    background: var(--clay);
    color: #fff8ee;
    transform: rotate(8deg);
  }

  @media (max-width: 40rem) {
    .entry-card {
      grid-template-columns: 2.8rem minmax(0, 1fr);
      gap: 0.65rem;
    }

    .entry-link {
      border-radius: 1.35rem;
      padding: 1.1rem;
    }

    .entry-reading-time {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    .entry-card {
      gap: 0.5rem;
      grid-template-columns: 2.35rem minmax(0, 1fr);
    }

    .entry-date strong {
      font-size: 1.15rem;
    }

    .entry-date span {
      font-size: 0.52rem;
    }

    .entry-link {
      border-radius: 1.1rem;
      padding: 1rem 0.9rem;
    }

    .entry-summary {
      font-size: 0.82rem;
    }
  }
</style>
