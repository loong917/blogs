---
const currentYear = new Date().getFullYear();
---

<footer>
  <a class="footer-brand" href="/" aria-label="返回首页"><i aria-hidden="true">L</i><span>LOONG'S BLOGS</span></a>
  <span class="footer-quote">Slow is smooth, smooth is fast.</span>
  <span>© {currentYear}</span>
</footer>

<style>
  footer {
    align-items: center;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    display: flex;
    font-size: 0.65rem;
    justify-content: space-between;
    letter-spacing: 0.08em;
    margin: 4.5rem auto 0;
    max-width: var(--content-width);
    padding: 1.5rem 0 0.5rem;
    width: 100%;
  }

  .footer-brand {
    align-items: center;
    display: inline-flex;
    gap: 0.55rem;
    text-decoration: none;
  }

  .footer-brand i {
    align-items: center;
    background: var(--accent-soft);
    border-radius: 50%;
    color: var(--clay-dark);
    display: inline-flex;
    font-family: var(--font-serif);
    font-size: 0.75rem;
    font-style: normal;
    height: 1.7rem;
    justify-content: center;
    width: 1.7rem;
  }

  @media (max-width: 640px) {
    footer {
      align-items: flex-start;
      gap: 0.5rem;
      margin-top: 3.5rem;
    }

    .footer-quote {
      display: none;
    }
  }

  @media (max-width: 24rem) {
    footer {
      flex-direction: column;
    }
  }
</style>
