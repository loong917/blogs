---
const { page } = Astro.props;
---

<nav class="pagination" aria-label="分页">
  {
    page.url.prev ? (
      <a href={page.url.prev}><span aria-hidden="true">←</span> 上一页</a>
    ) : (
      <span></span>
    )
  }
  <small>{page.currentPage} / {page.lastPage}</small>
  {
    page.url.next ? (
      <a href={page.url.next}>下一页 <span aria-hidden="true">→</span></a>
    ) : (
      <span></span>
    )
  }
</nav>

<style>
  .pagination {
    align-items: center;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    margin: 2.8rem 0 0 4.6rem;
    padding-top: 1.4rem;
  }

  a {
    color: var(--clay-dark);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  a:last-child {
    justify-self: end;
  }

  small {
    color: var(--ink-muted);
    font-size: 0.65rem;
  }

  @media (max-width: 540px) {
    .pagination {
      margin-left: 3.45rem;
    }
  }
</style>
