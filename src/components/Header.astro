---
interface Props {
  title: string;
  active?: 'latest' | 'articles' | 'tags';
}

const { title, active } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="返回首页" transition:name="site-brand">
    <span class="brand-mark">L</span>
    <span>
      <strong>{title}</strong>
    </span>
  </a>
  <nav aria-label="主导航">
    <a class:list={{ active: active === 'latest' }} aria-current={active === 'latest' ? 'page' : undefined} href="/">最新</a>
    <a class:list={{ active: active === 'articles' }} aria-current={active === 'articles' ? 'page' : undefined} href="/blogs">文章</a>
    <a class:list={{ active: active === 'tags' }} aria-current={active === 'tags' ? 'page' : undefined} href="/tags">标签</a>
  </nav>
</header>

<style>
  .site-header {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--content-width);
    padding: 0.35rem 0 1.25rem;
    width: 100%;
  }

  .brand {
    align-items: center;
    color: var(--ink);
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .brand:hover {
    opacity: 0.78;
  }

  .brand-mark {
    align-items: center;
    background: var(--clay);
    border-radius: 50% 50% 46% 54%;
    box-shadow: inset -4px -6px 12px rgba(108, 50, 28, 0.16);
    color: var(--paper);
    display: flex;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    height: 2.7rem;
    justify-content: center;
    transform: rotate(-4deg);
    width: 2.7rem;
  }

  .brand small,
  .brand strong {
    display: block;
  }

  .brand small {
    color: var(--ink-muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .brand strong {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 0.12rem;
  }

  nav {
    align-items: center;
    display: flex;
    gap: 0.35rem;
  }

  nav a {
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.8rem;
    padding: 0.65rem 0.9rem;
    position: relative;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  nav a:hover,
  nav a.active {
    background: rgba(255, 255, 255, 0.45);
    color: var(--clay-dark);
  }

  nav a.active::after {
    background: var(--clay);
    border-radius: 999px;
    bottom: 0.28rem;
    content: '';
    height: 2px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 0.9rem;
  }

  @media (max-width: 540px) {
    .site-header {
      padding-bottom: 1rem;
    }

    .brand small {
      display: none;
    }

    .brand strong {
      font-size: 1.05rem;
    }

    nav a {
      padding: 0.55rem 0.65rem;
    }

    nav a.active::after {
      bottom: 0.2rem;
    }
  }
</style>
