---
interface Props {
  title: string;
  active?: 'latest' | 'articles' | 'tags';
}

const { title, active } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="返回首页" transition:name="site-brand">
    <span class="brand-mark">L</span>
    <span>
      <strong>{title}</strong>
    </span>
  </a>
  <nav aria-label="主导航">
    <a class:list={{ active: active === 'latest' }} aria-current={active === 'latest' ? 'page' : undefined} href="/">最新</a>
    <a class:list={{ active: active === 'articles' }} aria-current={active === 'articles' ? 'page' : undefined} href="/blogs">文章</a>
    <a class:list={{ active: active === 'tags' }} aria-current={active === 'tags' ? 'page' : undefined} href="/tags">标签</a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="切换深色/浅色模式">
      <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="1.8" />
        <path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 2.5v2.3M12 19.2v2.3M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.5 12h2.3M19.2 12h2.3M4.4 19.6 6 18M18 6l1.6-1.6" />
      </svg>
      <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M20.5 14.7A8.5 8.5 0 1 1 9.3 3.5a7 7 0 0 0 11.2 11.2Z" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .site-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--content-width);
    padding: 0.4rem 0;
    position: sticky;
    top: max(0.75rem, env(safe-area-inset-top));
    width: 100%;
    z-index: 50;
  }

  .brand {
    align-items: center;
    color: var(--ink);
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .brand:hover {
    opacity: 0.78;
  }

  .brand-mark {
    align-items: center;
    background: var(--clay);
    border-radius: 50% 50% 46% 54%;
    box-shadow: inset -4px -6px 12px rgba(108, 50, 28, 0.16);
    color: var(--paper);
    display: flex;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    height: 2.45rem;
    justify-content: center;
    transform: rotate(-4deg);
    width: 2.45rem;
  }

  .brand small,
  .brand strong {
    display: block;
  }

  .brand small {
    color: var(--ink-muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  .brand strong {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 0.12rem;
  }

  nav {
    align-items: center;
    display: flex;
    gap: 0.35rem;
  }

  nav a {
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.8rem;
    min-height: 2.45rem;
    padding: 0.65rem 0.9rem;
    position: relative;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }

  nav a:hover,
  nav a.active {
    background: var(--surface-soft-hover);
    color: var(--clay-dark);
  }

  nav a.active::after {
    background: var(--clay);
    border-radius: 999px;
    bottom: 0.28rem;
    content: '';
    height: 2px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 0.9rem;
  }

  .theme-toggle {
    align-items: center;
    background: var(--surface-soft);
    border: 1px solid var(--surface-card-border);
    border-radius: 50%;
    color: var(--ink-soft);
    cursor: pointer;
    display: inline-flex;
    height: 2.45rem;
    justify-content: center;
    margin-left: 0.25rem;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
    width: 2.45rem;
  }

  .theme-toggle:hover {
    background: var(--surface-soft-hover);
    color: var(--clay-dark);
    transform: translateY(-1px);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }

  @media (max-width: 40rem) {
    .site-header {
      padding: 0.35rem 0;
    }

    .brand {
      gap: 0.55rem;
    }

    .brand-mark {
      font-size: 1rem;
      height: 2.2rem;
      width: 2.2rem;
    }

    .brand small {
      display: none;
    }

    .brand strong {
      font-size: 1.05rem;
    }

    nav a {
      align-items: center;
      display: inline-flex;
      min-height: 2.25rem;
      padding: 0.5rem 0.55rem;
    }

    nav {
      gap: 0.1rem;
    }

    nav a.active::after {
      bottom: 0.2rem;
    }

    .theme-toggle {
      height: 2.25rem;
      margin-left: 0.1rem;
      width: 2.25rem;
    }
  }

  @media (max-width: 23rem) {
    .site-header {
      display: grid;
      gap: 0.7rem;
      grid-template-columns: 1fr;
    }

    nav {
      border-top: 1px solid var(--line);
      justify-content: space-between;
      padding-top: 0.55rem;
      width: 100%;
    }

    nav a {
      flex: 1;
      justify-content: center;
      padding-inline: 0.45rem;
    }

    .theme-toggle {
      flex: 0 0 2.25rem;
    }
  }
</style>
