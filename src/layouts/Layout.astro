---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = '记录技术、见闻与持续发生的思考。', canonicalPath = '/' } = Astro.props;
const canonicalURL = new URL(canonicalPath, 'https://loongzxl.com');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3ecdf" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="loong博客" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳转到正文</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #f3ecdf;
    --ink: #302a24;
    --ink-soft: #665d53;
    --ink-muted: #91867a;
    --line: rgba(71, 59, 48, 0.12);
    --clay: #ca7048;
    --clay-dark: #995038;
    --content-width: 48.75rem;
    --page-gutter: clamp(1rem, 4vw, 3.5rem);
    --section-space: clamp(2rem, 5vw, 4rem);
    --font-serif: Georgia, 'Noto Serif SC', 'Songti SC', serif;
    --font-sans: Inter, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    background: var(--paper);
    margin: 0;
    min-height: 100vh;
    overflow-x: clip;
    padding: 0;
    position: relative;
  }

  body::-webkit-scrollbar {
    width: 5px;
  }

  body::-webkit-scrollbar-thumb {
    background: #5d544b;
    border-radius: 99px;
  }

  ::selection {
    background: rgba(202, 112, 72, 0.24);
  }

  ::view-transition-old(root) {
    animation: 180ms ease-out both journal-page-out;
  }

  ::view-transition-new(root) {
    animation: 260ms ease-out both journal-page-in;
  }

  @keyframes journal-page-out {
    to {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @keyframes journal-page-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  :focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 4px;
  }

  .skip-link {
    background: var(--ink);
    color: var(--paper);
    left: 1rem;
    padding: 0.7rem 1rem;
    position: fixed;
    text-decoration: none;
    top: 1rem;
    transform: translateY(-200%);
    transition: transform 160ms ease;
    z-index: 100;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  main {
    background: var(--paper);
    border: 0;
    border-radius: 0;
    box-shadow: none;
    margin: 0 auto;
    max-width: none;
    min-height: 100vh;
    overflow: hidden;
    padding: max(1.25rem, env(safe-area-inset-top)) max(var(--page-gutter), env(safe-area-inset-right)) max(1.25rem, env(safe-area-inset-bottom)) max(var(--page-gutter), env(safe-area-inset-left));
    position: relative;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  .page-kicker {
    color: var(--ink-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    margin: 0 0 0.55rem;
    text-transform: uppercase;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 8vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.03;
    margin: 0;
    text-wrap: balance;
  }

  .page-intro {
    color: var(--ink-soft);
    font-family: var(--font-serif);
    line-height: 1.75;
    margin: 0.9rem 0 0;
    max-width: 38rem;
  }

  .content-width {
    margin: 0 auto;
    max-width: var(--content-width);
    width: 100%;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 2rem 0 2.4rem;
  }

  .filter-pill {
    align-items: center;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(96, 78, 61, 0.06);
    border-radius: 999px;
    color: var(--ink-soft);
    display: inline-flex;
    font-size: 0.74rem;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.68rem 1rem;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .filter-pill.active,
  .filter-pill:hover {
    background: var(--clay);
    color: #fff8ee;
  }

  .filter-pill:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 48rem) {
    main {
      border-radius: 0;
      max-width: 100%;
      min-height: 100vh;
    }

    .filter-row {
      gap: 0.5rem;
      margin-block: 1.5rem 2rem;
    }
  }

  @media (max-width: 30rem) {
    :root {
      --page-gutter: 0.9rem;
    }

    .page-title {
      font-size: clamp(2rem, 13vw, 3.15rem);
      overflow-wrap: anywhere;
    }

    .page-intro {
      font-size: 0.95rem;
    }

    .filter-row {
      margin-top: 1.25rem;
    }

    .filter-pill {
      flex: 1 1 auto;
      padding-inline: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 0.01ms !important;
    }
  }
</style>
