---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = '记录技术、见闻与持续发生的思考。', canonicalPath = '/' } = Astro.props;
const canonicalURL = new URL(canonicalPath, 'https://loongzxl.com');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored === 'light' || stored === 'dark'
            ? stored
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3ecdf" id="meta-theme-color" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index, follow" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="loong博客" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳转到正文</a>
    <slot />
    <button
      type="button"
      id="back-to-top"
      class="back-to-top"
      aria-label="返回顶部"
      data-back-to-top
    >
      <span aria-hidden="true">↑</span>
    </button>
  </body>
</html>

<script>
  function getStoredTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem('theme');
    if (stored === 'light' || stored === 'dark') return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: 'light' | 'dark', animate = false) {
    if (animate) document.documentElement.dataset.themeAnimating = 'true';
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    const meta = document.getElementById('meta-theme-color');
    meta?.setAttribute('content', theme === 'dark' ? '#1c1712' : '#f3ecdf');
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
    });
    if (animate) {
      window.setTimeout(() => delete document.documentElement.dataset.themeAnimating, 220);
    }
  }

  function bindThemeToggle() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('theme', next);
        applyTheme(next, true);
      });
    });
  }

  let revealObserver: IntersectionObserver | null = null;
  function bindRevealObserver() {
    revealObserver?.disconnect();
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!targets.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver?.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => revealObserver?.observe(el));
  }

  function bindBackToTop() {
    const button = document.getElementById('back-to-top');
    if (!button || button.dataset.bound) return;
    button.dataset.bound = 'true';
    button?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  document.addEventListener('astro:after-swap', () => {
    applyTheme(getStoredTheme());
  });

  document.addEventListener('astro:page-load', () => {
    applyTheme(getStoredTheme());
    bindThemeToggle();
    bindRevealObserver();
    bindBackToTop();
  });

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        document.getElementById('back-to-top')?.classList.toggle('is-visible', window.scrollY > 480);
        ticking = false;
      });
    },
    { passive: true },
  );
</script>

<style is:global>
  :root {
    --paper: #f3ecdf;
    --ink: #302a24;
    --ink-soft: #665d53;
    --ink-muted: #91867a;
    --line: rgba(71, 59, 48, 0.12);
    --clay: #ca7048;
    --clay-dark: #995038;
    --content-width: 48.75rem;
    --collection-offset: clamp(3rem, 7vw, 5rem);
    --page-gutter: clamp(1rem, 4vw, 3.5rem);
    --section-space: clamp(2rem, 5vw, 4rem);
    --radius-sm: 0.75rem;
    --radius-md: 1.15rem;
    --radius-lg: 1.65rem;
    --radius-xl: 2.25rem;
    --font-serif: Georgia, 'Noto Serif SC', 'Songti SC', serif;
    --font-sans: Inter, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;

    --surface-card: color-mix(in srgb, var(--paper) 82%, white);
    --surface-card-border: rgba(78, 67, 53, 0.05);
    --surface-soft: rgba(255, 255, 255, 0.3);
    --surface-soft-hover: rgba(255, 255, 255, 0.45);
    --surface-subtle: rgba(255, 255, 255, 0.32);
    --surface-strong: rgba(255, 255, 255, 0.52);
    --shadow-card: 0 12px 35px rgba(75, 58, 41, 0.035);
    --shadow-card-hover: 0 16px 44px rgba(75, 58, 41, 0.08);
    --shadow-pop: 0 16px 42px rgba(61, 48, 37, 0.12);
    --shadow-float: 0 24px 70px rgba(75, 58, 41, 0.1);
    --accent-soft: color-mix(in srgb, var(--clay) 12%, transparent);
    --accent-border: color-mix(in srgb, var(--clay) 24%, transparent);

    --theme-toggle-transition: 0ms;
  }

  :root[data-theme-animating] {
    --theme-toggle-transition: 220ms ease;
  }

  :root[data-theme='dark'] {
    --paper: #1a1612;
    --ink: #f1e7d8;
    --ink-soft: #c9bcac;
    --ink-muted: #8d8176;
    --line: rgba(255, 244, 230, 0.1);
    --clay: #e2895c;
    --clay-dark: #f1a87d;

    --surface-card: color-mix(in srgb, var(--paper) 88%, white 12%);
    --surface-card-border: rgba(255, 255, 255, 0.07);
    --surface-soft: rgba(255, 255, 255, 0.045);
    --surface-soft-hover: rgba(255, 255, 255, 0.09);
    --surface-subtle: rgba(255, 255, 255, 0.06);
    --surface-strong: rgba(255, 255, 255, 0.14);
    --shadow-card: 0 12px 30px rgba(0, 0, 0, 0.35);
    --shadow-card-hover: 0 18px 44px rgba(0, 0, 0, 0.45);
    --shadow-pop: 0 18px 40px rgba(0, 0, 0, 0.5);
    --shadow-float: 0 28px 80px rgba(0, 0, 0, 0.5);
    --accent-soft: color-mix(in srgb, var(--clay) 14%, transparent);
    --accent-border: color-mix(in srgb, var(--clay) 28%, transparent);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100%;
    scroll-behavior: smooth;
    transition: background-color var(--theme-toggle-transition), color var(--theme-toggle-transition);
  }

  body {
    background:
      radial-gradient(circle at 12% 8%, var(--accent-soft), transparent 25rem),
      radial-gradient(circle at 88% 28%, color-mix(in srgb, var(--ink-muted) 8%, transparent), transparent 28rem),
      var(--paper);
    margin: 0;
    min-height: 100vh;
    overflow-x: clip;
    padding: 0;
    position: relative;
    transition: background-color var(--theme-toggle-transition);
  }

  body::-webkit-scrollbar {
    width: 5px;
  }

  body::-webkit-scrollbar-thumb {
    background: var(--ink-muted);
    border-radius: 99px;
  }

  ::selection {
    background: rgba(202, 112, 72, 0.24);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 560ms ease, transform 560ms ease;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .back-to-top {
    align-items: center;
    background: var(--ink);
    border: 0;
    border-radius: 50%;
    box-shadow: var(--shadow-card-hover);
    color: var(--paper);
    cursor: pointer;
    display: flex;
    font-size: 1.1rem;
    height: 2.9rem;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    right: clamp(1rem, 4vw, 2.25rem);
    bottom: clamp(1rem, 4vw, 2.25rem);
    transform: translateY(12px);
    transition: opacity 220ms ease, transform 220ms ease, background-color var(--theme-toggle-transition);
    width: 2.9rem;
    z-index: 40;
  }

  .back-to-top.is-visible {
    opacity: 0.88;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  ::view-transition-old(root) {
    animation: 140ms ease-out both journal-page-out;
  }

  ::view-transition-new(root) {
    animation: 180ms ease-out both journal-page-in;
  }

  @keyframes journal-page-out {
    to {
      opacity: 0;
    }
  }

  @keyframes journal-page-in {
    from {
      opacity: 0;
    }
  }

  :focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 4px;
  }

  .skip-link {
    background: var(--ink);
    color: var(--paper);
    left: 1rem;
    padding: 0.7rem 1rem;
    position: fixed;
    text-decoration: none;
    top: 1rem;
    transform: translateY(-200%);
    transition: transform 160ms ease;
    z-index: 100;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  main {
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    margin: 0 auto;
    max-width: none;
    min-height: 100vh;
    overflow: hidden;
    padding: max(1.25rem, env(safe-area-inset-top)) max(var(--page-gutter), env(safe-area-inset-right)) max(1.25rem, env(safe-area-inset-bottom)) max(var(--page-gutter), env(safe-area-inset-left));
    position: relative;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  .page-kicker {
    color: var(--ink-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    margin: 0 0 0.55rem;
    text-transform: uppercase;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 8vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.03;
    margin: 0;
    text-wrap: balance;
  }

  .page-intro {
    color: var(--ink-soft);
    font-family: var(--font-serif);
    line-height: 1.75;
    margin: 0.9rem 0 0;
    max-width: 38rem;
  }

  .content-width {
    margin: 0 auto;
    max-width: var(--content-width);
    width: 100%;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 2rem 0 2.4rem;
  }

  .filter-pill {
    align-items: center;
    background: var(--surface-soft);
    border: 1px solid var(--surface-card-border);
    border-radius: 999px;
    color: var(--ink-soft);
    display: inline-flex;
    flex: 0 1 9rem;
    font-size: 0.74rem;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 0;
    overflow: hidden;
    padding: 0.68rem 1rem;
    text-decoration: none;
    text-overflow: ellipsis;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
    white-space: nowrap;
  }

  .filter-pill.active,
  .filter-pill:hover {
    background: var(--clay);
    color: #fff8ee;
  }

  .filter-pill:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 48rem) {
    main {
      border-radius: 0;
      max-width: 100%;
      min-height: 100vh;
    }

    .filter-row {
      gap: 0.5rem;
      margin-block: 1.5rem 2rem;
    }
  }

  @media (max-width: 30rem) {
    :root {
      --page-gutter: 0.9rem;
    }

    .page-title {
      font-size: clamp(2rem, 13vw, 3.15rem);
      overflow-wrap: anywhere;
    }

    .page-intro {
      font-size: 0.95rem;
    }

    .filter-row {
      margin-top: 1.25rem;
    }

    .filter-pill {
      flex-basis: calc(50% - 0.325rem);
      padding-inline: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 0.01ms !important;
    }
  }
</style>
